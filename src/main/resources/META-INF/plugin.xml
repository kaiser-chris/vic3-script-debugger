<idea-plugin>
    <id>de.bahmut.vic3-script-debugger</id>
    <name>Victoria 3 Script Debugger</name>
    <vendor>Chris Kaiser</vendor>

    <description><![CDATA[
    Debugs Jomini script against a running Victoria 3 (1.15.0 and later) through the game's built-in
    script debugger: line breakpoints and logpoints, stepping, the game's scopes in the Variables view,
    and evaluation of script values and triggers. Start the game with <code>-script_debugger</code>, then
    debug a <b>Victoria 3 Script Debugger</b> run configuration.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xdebugger</depends>

    <resource-bundle>messages.Vic3Bundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="de.bahmut.vic3debugger.run.Vic3ConfigurationType"/>
        <programRunner implementation="de.bahmut.vic3debugger.run.Vic3DebugRunner"/>
        <xdebugger.breakpointType implementation="de.bahmut.vic3debugger.debugger.Vic3LineBreakpointType"/>
        <editorFloatingToolbarProvider implementation="de.bahmut.vic3debugger.editor.LoadedModToolbarProvider"
                                       id="Vic3ScriptDebuggerLoadedMod"/>
    </extensions>

    <actions>
        <group id="Vic3ScriptDebugger.EditorFloatingToolbar">
            <action id="Vic3ScriptDebugger.LoadedModIndicator" class="de.bahmut.vic3debugger.editor.LoadedModIndicatorAction"/>
        </group>
    </actions>
</idea-plugin>
